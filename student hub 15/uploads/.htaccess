# Block ALL script execution inside uploads/.
# Images may be served, but never parsed as PHP/Apache handlers.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh|bash|exe|com|bat)$">
    Require all denied
</FilesMatch>

# Belt and braces: remove handler mappings so nothing executes.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType application/x-httpd-php
php_flag engine off
